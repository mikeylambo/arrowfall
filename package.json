{
  "name": "arrowfall",
  "private": true,
  "version": "2.0.0-dev",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "npm run format:check && npm run typecheck && npm run lint && npm run test && npm run build && npm run e2e",
    "verify": "npm run check",
    "certify:web": "npm run verify && slu-certify web",
    "certify:mobile": "npm run verify && slu-certify mobile",
    "certify:controller": "npm run verify && slu-certify controller",
    "certify:release": "npm run verify && slu-certify release",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run tests/unit",
    "e2e": "playwright test",
    "preview": "vite preview --host 0.0.0.0",
    "prebuild": "node tools/sync-art.mjs",
    "predev": "node tools/sync-art.mjs",
    "format": "prettier --write src tests",
    "format:check": "prettier --check src tests",
    "bench": "vite-node tools/bench-sim.ts",
    "evidence": "node tools/capture-evidence.mjs"
  },
  "dependencies": {
    "@slu/web-shell": "github:mikeylambo/Web-Game-Shell-v1.02#d5bdb4ae2ac09109088a5f0e524badd60996ee3b",
    "pixi.js": "^8.14.0"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "vitest": "^3.2.4",
    "@playwright/test": "^1.55.0",
    "eslint": "^9.0.0",
    "typescript-eslint": "^8.0.0",
    "prettier": "^3.0.0"
  }
}
